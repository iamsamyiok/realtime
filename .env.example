# ---- Qwen Realtime (DashScope 百炼, https://bailian.console.aliyun.com) ----
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
QWEN_MODEL=qwen3.8-omni-flash-realtime
QWEN_VOICE=Tina
QWEN_REGION=cn-beijing

# ---- voice-hub ----
HUB_PORT=8090
# off | active(仅在检测到语音后约10s内注入帧) | always
FRAME_MODE=active
FRAME_INTERVAL_MS=4000
QWEN_IMAGE_MAX_BYTES=180000

# ---- camera pipeline (mcp-webcam streaming mode) ----
WEBCAM_URL=http://localhost:3333
WEBCAM_MCP_URL=http://localhost:3333/mcp
# 当 mcp-webcam 以 VOICE_HUB_FORWARD_URL=http://localhost:8090/frame 启动时,
# 它的所有截图会镜像到 hub(可选项,hub 自身也会主动轮询 capture)

# ---- Claude Code sandbox ----
VOICE_WORKSPACE=C:\Users\muxinyide\voice-workspace
